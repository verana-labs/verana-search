{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "maxSize": 10000000,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/coverage",
      "!**/pnpm-lock.yaml",
      "!**/*.css",
      "!public"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120,
    "includes": ["**", "!**/node_modules", "!**/.next", "!**/dist", "!**/coverage", "!**/pnpm-lock.yaml"]
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "lineWidth": 120,
      "indentStyle": "space"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off",
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "fix": "safe"
        },
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": "error",
        "noInvalidUseBeforeDeclaration": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noImportCycles": "error"
      },
      "complexity": {
        "noBannedTypes": "error"
      },
      "performance": {
        "noDelete": {
          "fix": "none",
          "level": "error"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["app/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "useButtonType": "off",
            "noSvgWithoutTitle": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "performance": {
            "noImgElement": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "warn",
            "useHookAtTopLevel": "warn"
          }
        }
      }
    },
    {
      "includes": ["lib/config.ts", "app/api/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
